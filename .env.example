# Copy this file to  .env  and fill in ONLY the broker you scan with.
# .env is git-ignored -- never commit it. NSE delivery data, --offline and
# --source local need no credentials at all.

# ---- Definedge  (python scan.py --source definedge) ------------------------
# Fully automatic login: the TOTP code is generated from the secret below.
DEFINEDGE_API_TOKEN=
DEFINEDGE_API_SECRET=
DEFINEDGE_TOTP_SECRET=

# ---- Kotak Neo  (python scan.py --source kotak) ----------------------------
# Only the consumer key is needed for market data -- no TOTP / MPIN login.
KOTAK_NEO_CONSUMER_KEY=
# KOTAK_NEO_ENV=prod

# ---- Fyers  (python scan.py --source fyers) --------------------------------
# The access token expires daily. Refresh it with:  python tools/fyers_login.py
FYERS_APP_ID=
FYERS_SECRET_KEY=
FYERS_REDIRECT_URI=
FYERS_ACCESS_TOKEN=
